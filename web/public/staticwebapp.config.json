{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "*.{js,css,json,webmanifest,png,svg,txt}"]
  },
  "routes": [
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "mimeTypes": { ".webmanifest": "application/manifest+json" },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; connect-src 'self' https://*.azurewebsites.net; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "geolocation=(self), camera=(), microphone=(), interest-cohort=()"
  }
}
