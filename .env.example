# Copy to .env and fill in. Never commit .env.

# DB API Marketplace: developers.deutschebahn.com -> create application -> subscribe to Timetables (free plan)
DB_CLIENT_ID=
DB_API_KEY=

# local = write to ./data, azure = Blob Storage + Data Explorer
SINK=local
LOCAL_DATA_DIR=data
HUBS_FILE=config/hubs.csv

# Only needed for SINK=azure
BLOB_ACCOUNT_URL=https://<storage account>.blob.core.windows.net
BLOB_CONTAINER=raw
KUSTO_INGEST_URI=https://ingest-<cluster>.<region>.kusto.windows.net
KUSTO_QUERY_URI=https://<cluster>.<region>.kusto.windows.net
KUSTO_DATABASE=anschlussradar
KUSTO_APP_ID=
KUSTO_APP_SECRET=
KUSTO_TENANT_ID=

# Only for scripts/translate_messages.py (run by hand, once per language)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
