{
  "version": "2.0",
  "functionTimeout": "00:00:30",
  "extensions": {
    "http": { "routePrefix": "api/v1" }
  },
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Warning" },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "maxTelemetryItemsPerSecond": 5, "excludedTypes": "Exception" }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
